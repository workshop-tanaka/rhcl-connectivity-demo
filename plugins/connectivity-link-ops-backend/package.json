{
  "name": "@rhcl/backstage-plugin-connectivity-link-ops-backend",
  "version": "0.15.0",
  "description": "Backend do plugin de Connectivity Link para o Red Hat Developer Hub",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "connectivity-link-ops",
    "pluginPackages": [
      "@rhcl/backstage-plugin-connectivity-link-ops",
      "@rhcl/backstage-plugin-connectivity-link-ops-backend"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-dynamic"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "test": "jest",
    "tsc": "tsc",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "rhdh-cli plugin export --shared-package @backstage/plugin-signals-node --shared-package @backstage/plugin-catalog-node"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.8.0",
    "@backstage/backend-test-utils": "^1.11.1",
    "@backstage/catalog-model": "^1.7.7",
    "@backstage/cli": "^0.36.0",
    "@backstage/errors": "^1.2.7",
    "@backstage/plugin-catalog-node": "^2.1.0",
    "@backstage/plugin-permission-common": "^0.9.7",
    "@backstage/plugin-permission-node": "^0.10.11",
    "@backstage/plugin-signals-node": "^0.1.29",
    "@red-hat-developer-hub/cli": "~1.10.0",
    "@types/express": "^4.17.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3"
  }
}
