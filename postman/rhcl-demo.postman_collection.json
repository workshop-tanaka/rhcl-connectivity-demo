              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a 5a requisicao em 10s leva 429 do Limitador', () => pm.response.to.have.status(429));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.variables.replaceIn('https://api-travels.{{apps_domain}}/travels/Rome?APIKEY={{api_key_free}}');",
                  "function bate(n, done) {",
                  "  if (n === 0) return done();",
                  "  pm.sendRequest(u, () => bate(n - 1, done));",
                  "}",
                  "bate(4, () => console.log('cota do free queimada'));"
                ]
              }
            }
          ]
        }
