{
  "info": {
    "name": "RHCL — bateria da borda: contrato, fechada, planos, versoes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "A bateria de testes da borda. Nucleo (roda sempre): 'Contrato', 'A borda e fechada', 'Planos por dados'. Opcionais: 'Versoes' (depois da parte 4.3), 'Echo OIDC', e as pastas de outros ambientes. Environment: scripts/postman-env.sh; dados por plano: postman/planos.local.csv (gerado pelo mesmo script)."
  },
  "item": [
    {
      "name": "Contrato — travels",
      "description": "O que a API promete no corpo. Um campo a menos ou um tipo diferente reprova aqui, mesmo com 200.",
      "item": [
        {
          "name": "GET /travels -> lista de destinos (schema)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{api_key_gold}}"
              }
            ],
            "url": {
              "raw": "https://{{api_host}}/travels",
              "protocol": "https",
              "host": [
                "{{api_host}}"
              ],
              "path": [
                "travels"
              ]
            },
            "description": "O contrato da lista. Se um campo sumir ou mudar de tipo, e aqui que cai."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON', () => pm.expect(pm.response.headers.get('content-type')).to.match(/application\\/json/));",
                  "const schema = {type:'array', minItems:1, items:{type:'object', required:['city','lat','lng'], properties:{city:{type:'string'}, lat:{type:'string'}, lng:{type:'string'}}}};",
                  "pm.test('contrato: lista de {city, lat, lng}', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('x-request-id presente (rastreavel)', () => pm.response.to.have.header('x-request-id'));",
                  "pm.test('responde em menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /travels/Rome -> um destino (schema)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{api_key_gold}}"
              }
            ],
            "url": {
              "raw": "https://{{api_host}}/travels/Rome",
              "protocol": "https",
              "host": [
                "{{api_host}}"
              ],
              "path": [
                "travels",
                "Rome"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const schema = {type:'object', required:['city','status','flights','hotels'], properties:{city:{type:'string'}, status:{type:'string'}, flights:{type:'array', items:{type:'object', required:['airline','price'], properties:{airline:{type:'string'}, price:{type:'number'}}}}, hotels:{type:'array'}}};",
                  "pm.test('contrato: city, status, flights[{airline, price}], hotels[]', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('city e o pedido', () => pm.expect(pm.response.json().city).to.eql('Rome'));"
                ]
              }
            }
          ]
        }
      ]
