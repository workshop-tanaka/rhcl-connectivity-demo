        {
          "name": "estourar o free numa execucao (429 deterministico)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api-travels.{{apps_domain}}/travels/Roma?APIKEY={{api_key_free}}",
              "protocol": "https",
              "host": [
                "api-travels",
                "{{apps_domain}}"
              ],
              "path": [
                "travels",
                "Roma"
              ],
              "query": [
                {
                  "key": "APIKEY",
                  "value": "{{api_key_free}}"
                }
              ]
            },
            "description": "O pre-request queima a cota do free (4 chamadas em serie); esta e a 5a."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a 5a requisicao em 10s leva 429 do Limitador', () => pm.response.to.have.status(429));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.variables.replaceIn('https://api-travels.{{apps_domain}}/travels/Roma?APIKEY={{api_key_free}}');",
                  "function bate(n, done) {",
                  "  if (n === 0) return done();",
                  "  pm.sendRequest(u, () => bate(n - 1, done));",
                  "}",
                  "bate(4, () => console.log('cota do free queimada'));"
                ]
              }
            }
          ]
        }
      ]
