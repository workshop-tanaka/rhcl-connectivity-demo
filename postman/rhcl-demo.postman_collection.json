    {
      "name": "Planos — por dados",
      "description": "Roda uma vez por linha de planos.local.csv: {{plano}}, {{chave}}, {{limite}}. A 1a responde 200; a limite+1 em 10 s leva 429.",
      "item": [
        {
          "name": "{{plano}}: dentro do limite -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{chave}}"
              }
            ],
            "url": {
              "raw": "https://{{api_host}}/travels/Rome",
              "protocol": "https",
              "host": [
                "{{api_host}}"
              ],
              "path": [
                "travels",
                "Rome"
              ]
            },
            "description": "Orientado a dados: uma linha por plano em postman/planos.local.csv (plano, chave, limite)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(pm.iterationData.get('plano') + ': a primeira do plano responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "{{plano}}: a requisicao limite+1 em 10 s -> 429",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{chave}}"
              }
            ],
            "url": {
              "raw": "https://{{api_host}}/travels/Rome",
              "protocol": "https",
              "host": [
                "{{api_host}}"
              ],
              "path": [
                "travels",
                "Rome"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// queima o resto da janela: ja gastou 1 na requisicao anterior; manda (limite-1) e a desta vira limite+1",
                  "const u = pm.variables.replaceIn('https://{{api_host}}/travels/Rome');",
                  "const chave = pm.iterationData.get('chave');",
                  "const n = Number(pm.iterationData.get('limite')) - 1;",
                  "function bate(k, done) { if (k <= 0) return done(); pm.sendRequest({url: u, method: 'GET', header: {Authorization: 'APIKEY ' + chave}}, () => bate(k - 1, done)); }",
                  "bate(n, () => console.log(pm.iterationData.get('plano') + ': ' + n + ' requisicoes a mais na janela'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const lim = Number(pm.iterationData.get('limite'));",
                  "pm.test(pm.iterationData.get('plano') + ': a requisicao ' + (lim + 1) + ' em 10 s leva 429 do Limitador', () => pm.response.to.have.status(429));",
                  "pm.test('o 429 nasce na borda: corpo curto, sem JSON da aplicacao', () => pm.expect(pm.response.text()).to.include('Too Many Requests'));"
                ]
              }
            }
          ]
        }
      ]
    },
