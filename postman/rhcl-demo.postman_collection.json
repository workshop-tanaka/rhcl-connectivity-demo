        {
          "name": "echo SEM token -> 302 para o Keycloak (OIDCPolicy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://echo-travels.{{apps_domain}}/qualquer",
              "protocol": "https",
              "host": [
                "echo-travels",
                "{{apps_domain}}"
              ],
              "path": [
                "qualquer"
              ],
              "query": []
            },
            "description": "O deny-all e de GATEWAY: rota nova sem AuthPolicy propria ja nasce negada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// OIDCPolicy desde 2026-09-01: sem credencial o gateway REDIRECIONA",
                  "// para o login do Keycloak em vez do 401 seco da AuthPolicy antiga.",
                  "// Desligue 'Automatically follow redirects' nas settings do Postman",
                  "// para ver o 302; com follow ligado, o teste aceita a pagina de login.",
                  "pm.test('echo sem token redireciona ao Keycloak (ou entrega o login)', () => {",
                  "    if (pm.response.code === 302) {",
                  "        pm.expect(pm.response.headers.get('Location')).to.include('/protocol/openid-connect/auth');",
                  "    } else {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "        pm.expect(pm.response.text()).to.include('Sign in');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
