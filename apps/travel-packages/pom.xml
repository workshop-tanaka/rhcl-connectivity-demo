<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  travel-packages — o primeiro artefato COMPILÁVEL desta demo.

  POR QUE ELE EXISTE: até 2026-08-28 nenhum serviço daqui tinha código. Os
  backends rodam a imagem de exemplo do Kiali, e a consequência é que sete
  produtos de cadeia de suprimento (Nexus, SonarQube, Chains, Rekor, ACS,
  Quay, Tekton) estavam instalados sem nada passando por eles. Este módulo é
  o que os acende.

  O QUE ELE SERVE: os 480 pacotes e ~1200 reservas que o seed de
  platform-reference/travel-packages/02-schema-e-massa.yaml pôs no Postgres,
  filtrados por tier — o mesmo free/silver/gold dos planos do RHCL. É o que
  faz o Ato 2 ter efeito de negócio, e não só código de status.

  ===========================================================================
  EAP 8 NÃO SE CONFIGURA POR VARIÁVEL DE AMBIENTE NO BUILD.

  No EAP 7 havia GALLEON_PROVISION_LAYERS na imagem s2i. No 8 esse caminho é
  deprecado: quem provisiona o servidor é o eap-maven-plugin, aqui embaixo, e
  o resultado sai em target/server — que o Dockerfile copia para /opt/server
  da imagem de runtime (que nasce vazia de propósito).

  A camada 'postgresql-datasource' vem do eap-datasources-galleon-pack e é ela
  que lê POSTGRESQL_HOST/PORT/DATABASE/USER/PASSWORD em TEMPO DE EXECUÇÃO —
  as mesmas variáveis que o WildFlyServer de 06-eap.yaml injeta a partir do
  Secret que o CloudNativePG gera. Nenhuma senha entra na imagem.
  ===========================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.redhat.travel</groupId>
  <artifactId>travel-packages</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>
  <name>travel-packages</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <failOnMissingWebXml>false</failOnMissingWebXml>

    <!--
      COORDENADAS CONFERIDAS contra maven.repository.redhat.com em 2026-08-28.
      A primeira versão deste arquivo tinha TRÊS das quatro erradas, e ainda
      apontava para a linha 8.0 — a atual é a 8.1. Comando que resolve:

        curl -s https://maven.repository.redhat.com/ga/org/jboss/eap/\
        wildfly-ee-galleon-pack/maven-metadata.xml | grep '<version>' | tail -3

      O ERRO MAIS CARO ERA O NOME, e não a versão: 'eap-galleon-pack' não
      existe (HTTP 404 no metadata). O feature pack base chama-se
      'wildfly-ee-galleon-pack', sob o mesmo groupId org.jboss.eap.

      FIXAR VERSÃO AQUI É A OPÇÃO CONSERVADORA, não a recomendada. O EAP 8.1
      publica CANAIS (org.jboss.eap.channels:eap-8.1, hoje na 1.7.1.GA-redhat-00001)
      e o eap-maven-plugin 2.x os aceita em <channels>, resolvendo as versões
      dos feature packs sozinho — o que faz este bloco inteiro desaparecer.
      Ficou de fora porque a forma exata do <channels> não foi verificada
      contra um build real, e coordenada verificada vale mais que configuração
      elegante que ninguém rodou. É a primeira coisa a trocar depois do
      primeiro build verde.
    -->
    <version.eap.galleon.pack>8.1.1.GA-redhat-00019</version.eap.galleon.pack>
    <version.eap.datasources.pack>8.1.1.Final-redhat-00016</version.eap.datasources.pack>
    <version.eap.maven.plugin>2.0.1.Final-redhat-00016</version.eap.maven.plugin>
    <version.eap.bom>8.1.7.GA-redhat-00004</version.eap.bom>

    <!-- Hot Rod: cliente do Data Grid. Vai DENTRO do WAR (escopo compile) —
         não é uma camada do servidor, e por isso não aparece no Galleon. -->
    <version.infinispan>15.0.11.Final</version.infinispan>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jboss.bom</groupId>
        <artifactId>jboss-eap-ee</artifactId>
        <version>${version.eap.bom}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Jakarta EE 10 inteiro é 'provided': quem entrega é o servidor
         provisionado, e duplicá-lo no WAR é a forma clássica de ganhar
         ClassCastException entre dois carregadores de classe. -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.infinispan</groupId>
      <artifactId>infinispan-client-hotrod</artifactId>
      <version>${version.infinispan}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>travel-packages</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>

      <!-- JaCoCo existe por causa do PORTÃO DE QUALIDADE: sem relatório de
           cobertura o SonarQube aceita o projeto e reporta 0%, o que passa
           em qualquer quality gate baseado em código novo. O portão que não
           reprova não é portão. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepara-agente</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>relatorio</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Provisiona o servidor em target/server e implanta o WAR nele.
           'jaxrs-server' é a camada base (Jakarta REST + CDI + JPA);
           'postgresql-datasource' acrescenta driver, módulo e o datasource
           configurável por ambiente. -->
      <plugin>
        <groupId>org.jboss.eap.plugins</groupId>
        <artifactId>eap-maven-plugin</artifactId>
        <version>${version.eap.maven.plugin}</version>
        <configuration>
          <feature-packs>
            <feature-pack>
              <groupId>org.jboss.eap</groupId>
              <artifactId>wildfly-ee-galleon-pack</artifactId>
              <version>${version.eap.galleon.pack}</version>
            </feature-pack>
            <feature-pack>
              <groupId>org.jboss.eap</groupId>
              <artifactId>eap-datasources-galleon-pack</artifactId>
              <version>${version.eap.datasources.pack}</version>
            </feature-pack>
          </feature-packs>
          <layers>
            <layer>jaxrs-server</layer>
            <layer>postgresql-datasource</layer>
          </layers>
          <!-- Sem isto o provisionamento falha pedindo a versão do driver.
               É build-time; nada a ver com as variáveis de execução. -->
          <galleon-options>
            <jboss-fork-embedded>true</jboss-fork-embedded>
          </galleon-options>
        </configuration>
        <executions>
          <execution>
            <goals><goal>package</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>redhat-ga</id>
      <url>https://maven.repository.redhat.com/ga/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>redhat-ga</id>
      <url>https://maven.repository.redhat.com/ga/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>
